rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - allow users to create and manage their own profile
    match /users/{userId} {
      // Allow read if authenticated
      allow read: if request.auth != null;
      
      // Allow create if the userId matches the authenticated user
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow update/delete only if it's their own document
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Doctors collection - extends user data for doctors
    match /doctors/{doctorId} {
      // Anyone authenticated can read doctor profiles
      allow read: if request.auth != null;
      
      // Only the doctor can create/update their own profile
      allow create, update: if request.auth != null && request.auth.uid == doctorId;
      
      // Only the doctor can delete their profile
      allow delete: if request.auth != null && request.auth.uid == doctorId;
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      // Allow read if user is patient or doctor in the appointment
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId
      );
      
      // Allow create for authenticated users
      allow create: if request.auth != null;
      
      // Allow update if user is patient or doctor in the appointment
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId
      );
      
      // Allow delete only by patient who created it
      allow delete: if request.auth != null && request.auth.uid == resource.data.patientId;
    }
    
    // Prescriptions collection
    match /prescriptions/{prescriptionId} {
      // Allow read if user is patient or doctor in the prescription
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        ('doctorId' in resource.data && request.auth.uid == resource.data.doctorId)
      );
      
      // Allow create for authenticated users
      allow create: if request.auth != null;
      
      // Allow update if patient or doctor who created it
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        ('doctorId' in resource.data && request.auth.uid == resource.data.doctorId)
      );
      
      // Allow delete if patient who uploaded or doctor who created
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        ('doctorId' in resource.data && request.auth.uid == resource.data.doctorId)
      );
    }
    
    // Medical history collection
    match /medical_history/{historyId} {
      // Allow read if user is patient or their doctor
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId
      );
      
      // Allow create for authenticated users
      allow create: if request.auth != null;
      
      // Allow update by patient or doctor
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId
      );
    }
    
    // Hospitals collection
    match /hospitals/{hospitalId} {
      // Anyone authenticated can read hospitals
      allow read: if request.auth != null;
      
      // Only admins can create/update hospitals (for now, allow any authenticated user)
      allow create, update: if request.auth != null;
    }
    
    // Doctor schedules collection
    match /doctor_schedules/{scheduleId} {
      // Anyone can read schedules
      allow read: if request.auth != null;
      
      // Only the doctor can create/update their schedule
      allow create, update: if request.auth != null;
      
      // Only the doctor can delete their schedule
      allow delete: if request.auth != null;
    }
    
    // Allow all authenticated users to read/write (TEMPORARY - for development)
    // Remove this in production and use the specific rules above
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
